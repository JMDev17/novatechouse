/* ==========================================================================
   NOVA TECHOUSE - EMERALD GREEN THEME & AMBIENT MONOCHROMATIC GRADIENTS
   ========================================================================== */
html {
  scroll-behavior: smooth;
  background-color: #060e0a;
}

body {
  background-color: #060e0a;
  background-image: 
    radial-gradient(ellipse 120% 70% at 50% 0%, rgba(16, 185, 129, 0.24) 0%, rgba(10, 24, 18, 0.6) 40%, rgba(6, 14, 10, 1) 75%),
    radial-gradient(ellipse 80% 60% at 90% 35%, rgba(16, 185, 129, 0.13) 0%, transparent 60%),
    radial-gradient(ellipse 80% 60% at 10% 65%, rgba(16, 185, 129, 0.13) 0%, transparent 60%),
    radial-gradient(ellipse 100% 70% at 50% 100%, rgba(16, 185, 129, 0.19) 0%, rgba(10, 24, 18, 0.5) 45%, transparent 75%);
  background-attachment: fixed;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  color: #fff;
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

section {
  position: relative;
  background-color: transparent;
}

h1, h2, h3, h4, h5, h6, .font-display {
  font-family: 'Space Grotesk', sans-serif;
}

::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: #060e0a;
}
::-webkit-scrollbar-thumb {
  background: #132b20;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #10b981;
}

.noise-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

/* Green & White Text Gradients */
.text-gradient {
  background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.text-gradient-accent {
  background: linear-gradient(135deg, #a7f3d0 0%, #34d399 50%, #10b981 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Hero & Section Ambient Green Background */
.hero-bg {
  background: radial-gradient(ellipse 90% 75% at 50% 35%, rgba(16, 185, 129, 0.26) 0%, rgba(10, 24, 18, 0.6) 50%, transparent 80%);
}

/* Glass Panels with Emerald Dark Tone */
.glass-panel {
  background: rgba(10, 24, 18, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(16, 185, 129, 0.16);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}

.glass-panel:hover,
.glass-panel-hover:hover {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.38);
  box-shadow: 0 0 25px rgba(16, 185, 129, 0.15);
}

.magnetic-btn {
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.magnetic-btn:hover {
  transform: scale(1.03) translateY(-1px);
}

.link-hover {
  position: relative;
  display: inline-block;
}

.link-hover::after {
  content: '';
  position: absolute;
  width: 100%;
  transform: scaleX(0);
  height: 1px;
  bottom: -2px;
  left: 0;
  background-color: #10b981;
  transform-origin: bottom right;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.link-hover:hover::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

@keyframes pulse-dot {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.status-dot {
  animation: pulse-dot 2s infinite;
}

.reveal-text {
  clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
}

.hardware-card {
  position: relative;
  overflow: hidden;
  border-radius: 1rem;
}

.hardware-card .card-img-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.4s ease;
  z-index: 0;
  opacity: 0.82;
}

.hardware-card:hover .card-img-bg {
  transform: scale(1.06);
  opacity: 1;
}

.hardware-card .card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(6, 14, 10, 0.98) 0%, rgba(6, 14, 10, 0.65) 40%, rgba(16, 185, 129, 0.08) 75%, transparent 100%);
  z-index: 1;
}

.hardware-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
}

.services-card {
  height: 16rem;
  flex: none;
  border-radius: 1rem;
}

#navbar.navbar-scrolled {
  background: rgba(6, 14, 10, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(16, 185, 129, 0.20);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
}

.active-drag {
  cursor: grabbing !important;
  user-select: none;
}

